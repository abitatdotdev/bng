{
  "name": "@abitat/bng",
  "version": "0.14.1",
  "private": false,
  "description": "Open Source Statutory Biodiversity Metric",
  "homepage": "https://github.com/abitatdotdev/bng",
  "bugs": {
    "url": "https://github.com/abitatdotdev/bng/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abitatdotdev/bng.git"
  },
  "license": "LGPL-3.0",
  "author": "Matt Williams <matt@abitat.dev>",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser/index.mjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "mcp:habitat": "bun run mcp-server/habitat-server.ts",
    "gencode": "bun scripts/generateCodeFromSheet.ts",
    "test:fast": "bun test --concurrent ./src",
    "test:compare": "bun test test/comparison.test.ts",
    "test:debug": "bun test --inspect-wait",
    "clean": "rm -rf dist",
    "build:types": "tsc -p tsconfig.build.json",
    "build:node": "bun build src/index.ts --format esm --target node --outdir dist",
    "build:node:cjs": "bun build src/index.ts --format cjs --target node --outfile dist/index.cjs",
    "build:browser:esm": "bun build src/browser.ts --format esm --target browser --outfile dist/browser/index.mjs",
    "build": "bun run clean && bun run build:types && bun run build:node && bun run build:node:cjs && bun run build:browser:esm",
    "build:publish": "bun run build && bun publish && bun run clean",
    "release": "bun pm version"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "fflate": "^0.8.2",
    "valibot": "^1.2.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}

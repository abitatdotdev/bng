    "engine": "Microsoft Excel for Mac 16.113.4",
    "calculation": "Scratch copy; input writes read back; baseline and enhancement ranges calculated three times per case",
    "formulas": {
      "B-3 On-Site Hedge Enhancement": {
        "B12": "='B-1 On-Site Hedge Baseline'!AK10",
        "C12": "=IF(B12=\"\",\"\",IF(ISNA(VLOOKUP($B12,'B-1 On-Site Hedge Baseline'!$B$1:$L$257,3,FALSE)),\"\",(VLOOKUP($B12,'B-1 On-Site Hedge Baseline'!$B$1:$L$257,3,FALSE))))",
        "N12": "=IFERROR(IF(B12=\"\",\"\",INDEX('G-6 Hedgerow Data'!$AN$3:$AZ$15,MATCH(C12,'G-6 Hedgerow Data'!$AM$3:$AM$15,0),MATCH(M12,'G-6 Hedgerow Data'!$AN$2:$AZ$2,0))),\"\")",
        "O12": "=IFERROR(IF(B12=\"\",\"\",IF(AND(LEFT(C12,55)<>LEFT(M12,55),N12=\"High - High\"),\"Error - Not like for like ▲\",IF(H12>T12,\"Error - Can not reduce condition ▲\",IF(AND(F12=R12,H12=T12),\"Error - No enhancement ▲\",IF(AND(C12<>M12,F12<R12),\"Lower Distinctiveness Habitat\"&\" - \"&S12,G12&\" - \"&S12))))),\"\")",
        "P12": "=IF(B12=\"\",\"\",VLOOKUP(B12,'B-1 On-Site Hedge Baseline'!$B$10:T257,16,FALSE))",
        "X12": "=IFERROR(IF(OR(LEFT(O12,5)=\"Error\",LEFT(N12,5)=\"Error\",T12=\"Error\"),\"Check Data ⚠\",IF(F12<R12,INDEX('G-6 Hedgerow Data'!$S$3:$AE$14,MATCH(C12,'G-6 Hedgerow Data'!$B$3:$B$14,0),MATCH(M12,'G-6 Hedgerow Data'!$S$2:$AE$2,0)),INDEX('G-6 Hedgerow Data'!$K$3:$Q$14,MATCH(M12,'G-6 Hedgerow Data'!$B$3:$B$14,0),MATCH(O12,'G-6 Hedgerow Data'!$K$2:$Q$2,0)))),\"\")",
        "AA12": "=IF(X12=\"Check Data ⚠\",\"Check Data ⚠\",IF(M12=\"\",\"\",IF(AND(Y12>0,Z12>0),\"Error -both advance and delayed habitat creation ▲\",IF(AND(OR(Y12=\"Habitat already in target condition\",X12<=Y12),Z12=0),\"Check details - Is there evidence that habitat has reached target condition? ⚠\",IF(X12=\"\",\"\",IF(Y12>0,\"Check details - Is there evidence habitat creation started/in place? ⚠\",IF(Z12>0,\"Check details- Delay in starting habitat in required condition? ⚠\",\"Standard time to target condition applied\")))))))",
        "AB12": "=IF(X12=\"\",\"\",IF(AA12=\"Check Data ⚠\",\"Check Data ⚠\",IF(Y12=\"30+\",0, IF(X12=\"Not possible ▲\", \"Check Data ⚠\", IF(Z12=\"30+\",\"30+\",IF(X12+Z12>30,\"30+\",IF(AA12=\"Error -both advance and delayed habitat creation ▲\",\"Check Data ⚠\",IF(X12+Z12-Y12>0,X12+Z12-Y12,IF(X12-Y12<=0,0,)))))))))",
        "AC12": "=IF(OR(S12=\"\",M12=\"\"),\"\",IF(LEFT(AB12,5)=\"Error ▲\",\"Check Data ⚠\",IF(AB12=\"Check Data ⚠\",\"Check Data ⚠\",VLOOKUP(AB12,TemporalMultipliers,3,FALSE))))",
        "AD12": "=IF(M12=\"\",\"\",VLOOKUP(M12,'G-6 Hedgerow Data'!$B$3:$AG$15,31,FALSE))",
        "AE12": "=IF(M12=\"\",\"\",IF(OR(LEFT(AA12,5)=\"Error ▲\",AA12=\"Check Data ⚠\"),\"Check Data ⚠\",IF(X12=\"\",\"\",IF($AA12=\"Check details - Is there evidence that habitat has reached target condition? ⚠\",\"Low Difficulty - only applicable if all habitat created before losses ⚠\",\"Standard difficulty applied\"))))",
        "AF12": "=(IF(AND(AE12=\"Standard difficulty applied\",X12>Y12),AD12, IF(AB12=\"Check data ⚠\", \"Check data ⚠\", IF(AND(AE12=\"Low Difficulty - only applicable if all habitat created before losses ⚠\",Y12>=X12),\"Low\",AD12))))",
        "AG12": "=IFERROR(IF(O12=\"\",\"\",VLOOKUP(AD12,'G-3 Multipliers'!$P$3:$Q$6,2,FALSE)),\"\")",
        "AH12": "=IFERROR(IF(K12=\"Check data ⚠\", \"Check data ⚠\", (IF(OR(M12=\"\",S12=\"\",U12=\"\"),\"\",(((((P12*R12*T12)-(P12*F12*H12))*(AG12*AC12))+(P12*F12*H12))*(W12))))),\"\")"
      },
      "E-3 Off-Site Hedge Enhancement": {
        "B12": "='E-1 Off-Site Hedge Baseline'!AN10",
        "C12": "=IF(B12=\"\",\"\",IF(ISNA(VLOOKUP($B12,'E-1 Off-Site Hedge Baseline'!$B$1:$L$257,3,FALSE)),\"\",(VLOOKUP($B12,'E-1 Off-Site Hedge Baseline'!$B$1:$L$257,3,FALSE))))",
        "N12": "=IFERROR(IF(B12=\"\",\"\",INDEX('G-6 Hedgerow Data'!$AN$3:$AZ$15,MATCH(C12,'G-6 Hedgerow Data'!$AM$3:$AM$15,0),MATCH(M12,'G-6 Hedgerow Data'!$AN$2:$AZ$2,0))),\"\")",
        "O12": "=IFERROR(IF(B12=\"\",\"\",IF(AND(LEFT(C12,55)<>LEFT(M12,55),N12=\"High - High\"),\"Error - Not like for like ▲\",IF(H12>T12,\"Error - Can not reduce condition ▲\",IF(AND(F12=R12,H12=T12),\"Error - No enhancement ▲\",IF(AND(C12<>M12,F12<R12),\"Lower Distinctiveness Habitat\"&\" - \"&S12,G12&\" - \"&S12))))),\"\")",
        "P12": "=IF(B12=\"\",\"\",VLOOKUP(B12,'E-1 Off-Site Hedge Baseline'!$B$10:W257,19,FALSE))",
        "X12": "=IFERROR(IF(OR(LEFT(O12,5)=\"Error\",LEFT(N12,5)=\"Error\",T12=\"Error\"),\"Check Data ⚠\",IF(F12<R12,INDEX('G-6 Hedgerow Data'!$S$3:$AE$14,MATCH(C12,'G-6 Hedgerow Data'!$B$3:$B$14,0),MATCH(M12,'G-6 Hedgerow Data'!$S$2:$AE$2,0)),INDEX('G-6 Hedgerow Data'!$K$3:$Q$14,MATCH(M12,'G-6 Hedgerow Data'!$B$3:$B$14,0),MATCH(O12,'G-6 Hedgerow Data'!$K$2:$Q$2,0)))),\"\")",
        "AA12": "=IF(X12=\"Check Data ⚠\",\"Check Data ⚠\",IF(M12=\"\",\"\",IF(AND(Y12>0,Z12>0),\"Error -both advance and delayed habitat creation ▲\",IF(AND(OR(Y12=\"Habitat already in target condition\",X12<=Y12),Z12=0),\"Check details - Is there evidence that habitat has reached target condition? ⚠\",IF(X12=\"\",\"\",IF(Y12>0,\"Check details - Is there evidence habitat creation started/in place? ⚠\",IF(Z12>0,\"Check details- Delay in starting habitat in required condition? ⚠\",\"Standard time to target condition applied\")))))))",
        "AB12": "=IF(X12=\"\",\"\",IF(AA12=\"Check Data ⚠\",\"Check Data ⚠\",IF(X12=\"Not possible ▲\", \"Check data ⚠\", IF(Y12=\"30+\",0,IF(Z12=\"30+\",\"30+\",IF(X12+Z12>30,\"30+\",IF(AA12=\"Error -both advance and delayed habitat creation ▲\",\"Check Data ⚠\",IF(X12+Z12-Y12>0,X12+Z12-Y12,IF(X12-Y12<=0,0,)))))))))",
        "AC12": "=IF(OR(S12=\"\",M12=\"\"),\"\",IF(LEFT(AB12,5)=\"Error ▲\",\"Check Data ⚠\",IF(AB12=\"Check Data ⚠\",\"Check Data ⚠\",VLOOKUP(AB12,TemporalMultipliers,3,FALSE))))",
        "AD12": "=IF(M12=\"\",\"\",VLOOKUP(M12,'G-6 Hedgerow Data'!$B$3:$AG$15,31,FALSE))",
        "AE12": "=IF(M12=\"\",\"\",IF(OR(LEFT(AA12,5)=\"Error ▲\",AA12=\"Check Data ⚠\"),\"Check Data ⚠\",IF(X12=\"\",\"\",IF($AA12=\"Check details - Is there evidence that habitat has reached target condition? ⚠\",\"Low Difficulty - only applicable if all habitat created before losses ⚠\",\"Standard difficulty applied\"))))",
        "AF12": "=(IF(AND(AE12=\"Yes\",X12>Y12),AD12,IF(AB12=\"Check data ⚠\", \"Check data ⚠\", IF(AND(AE12=\"Low Difficulty - only applicable if all habitat created before losses ⚠\",Y12>=X12),\"Low\",AD12))))",
        "AG12": "=IFERROR(IF(O12=\"\",\"\",VLOOKUP(AD12,'G-3 Multipliers'!$P$3:$Q$6,2,FALSE)),\"\")",
        "AH12": "=IF(B12=\"\",\"\",IF(ISNA(VLOOKUP($B12,'E-1 Off-Site Hedge Baseline'!$B$1:$Z$257,14,FALSE)),\"\",(VLOOKUP($B12,'E-1 Off-Site Hedge Baseline'!$B$1:$Z$257,14,FALSE))))",
        "AI12": "=IF(AH12=\"\",\"\",IF(VLOOKUP(AH12,'G-3 Multipliers'!$S$3:$T$10,2,FALSE)=0,\"Spatial Data Missing ⚠\",VLOOKUP(AH12,'G-3 Multipliers'!$S$3:$T$10,2,FALSE)))",
        "AJ12": "=IFERROR(IF(AK12=\"Check data ⚠\", \"Check data ⚠\",(IF(OR(M12=\"\",S12=\"\",U12=\"\",AH12=\"\"),\"\",(((((P12*R12*T12)-(P12*F12*H12))*(AG12*AC12))+(P12*F12*H12))*(W12)*AI12)))),\"\")",
        "AK12": "=IFERROR(IF(K12=\"Check data ⚠\", \"Check data ⚠\", (IF(AND(AH12<>\"\",AO12=\"\"), \"Off-site reference required ▲\",(IF(OR(M12=\"\",S12=\"\",U12=\"\",AH12=\"\"),\"\", IF(AH12=\"\",\"\",(((((P12*R12*T12)-(P12*F12*H12))*(AG12*AC12))+(P12*F12*H12))*(W12)))))))),\"\")"
      }
    }
